# Copy to .env and replace placeholders. Do not commit real secrets.

# Local SQLite file. For PostgreSQL use:
# postgresql+psycopg://election:change-me@localhost:5432/election
DATABASE_URL=sqlite:///./data/elections.db

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave empty to leave the API open on trusted local networks.
API_TOKEN=

# Optional OpenAI-compatible chat completions endpoint. Empty keeps the deterministic parser.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_ITERATIONS=50000

# Used by the Next.js server to reach the API. Inside Compose this is http://api:8000.
API_INTERNAL_URL=http://127.0.0.1:8000

# Local Compose database password. Change it before any shared deployment.
POSTGRES_PASSWORD=change-me-local-only
