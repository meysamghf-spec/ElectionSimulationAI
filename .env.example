# Copy to .env and replace placeholders. Do not commit real secrets.

# Local SQLite file. Production must use PostgreSQL, for example:
# postgresql+psycopg://election:REPLACE_WITH_A_LONG_PASSWORD@db:5432/election
DATABASE_URL=sqlite:///./data/elections.db

# Production requires explicit https origins. Local development can use http.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# development: open local workspace. private: one shared server token. accounts: per-user ownership.
AUTH_MODE=development

# Private mode only. At least 32 characters in production. Leave empty for development and accounts.
API_TOKEN=

# Accounts mode. Leave this false. Production startup rejects true.
ALLOW_REGISTRATION=false

# Used once, only when accounts mode has zero users. Remove the password after the first boot.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Operator command: python -m app.auth.cli
# The password is read from the environment, not from the command line.
CREATE_USER_EMAIL=
CREATE_USER_PASSWORD=

SESSION_HOURS=12

# Optional OpenAI-compatible chat completions endpoint. Empty keeps the deterministic parser.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Production refuses to start unless AUTH_MODE is accounts or private and the database checks pass.
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_ITERATIONS=50000

# Used by the Next.js server to reach the API. Inside Compose this is http://api:8000.
# Do not set NEXT_PUBLIC_API_INTERNAL_URL or NEXT_PUBLIC_API_TOKEN.
API_INTERNAL_URL=http://127.0.0.1:8000

# Local Compose database password. Production startup rejects this placeholder.
POSTGRES_PASSWORD=change-me-local-only

# ---------------------------------------------------------------------------
# Production (docker-compose.yml behind the server's shared Caddy). See DEPLOY.md.
# Generate secrets on the server, e.g.:  openssl rand -base64 36 | tr -d '/+=' 
# ---------------------------------------------------------------------------
# Public hostname only, no https:// and no path. Example: election.example.ir
SITE_ADDRESS=
# Bundled database password (at least 16 characters, not a placeholder).
# POSTGRES_PASSWORD above is reused by docker-compose.yml.
# Shared PostgreSQL instead (docker-compose.shared-db.yml): full URL to the shared server.
# DATABASE_URL=postgresql+psycopg://electionsim:REPLACE_WITH_A_LONG_PASSWORD@postgres:5432/electionsim
# SHARED_DB_NETWORK=postgres
# Name of the external Docker network shared with Caddy (created once per server).
PROXY_NETWORK=caddy
# Interface language for first-time visitors: en (English, LTR, default) or fa (Persian, RTL).
# Visitors can switch in the header; their choice is saved in the browser.
DEFAULT_LOCALE=en
# Optional mirrors for servers in Iran where Docker Hub, PyPI or npm are blocked or slow.
# Leave empty to use the official sources.
POSTGRES_IMAGE=
PYTHON_IMAGE=
NODE_IMAGE=
PIP_INDEX_URL=
NPM_REGISTRY=
# Production pins TRUSTED_PROXY_CIDRS to the web container (172.28.10.10/32). Leave empty locally.
TRUSTED_PROXY_CIDRS=
# Set to true only after the first account exists and INITIAL_ADMIN_PASSWORD has been removed.
EXISTING_USERS=
