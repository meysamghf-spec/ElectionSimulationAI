# Copy to .env and replace placeholders. Do not commit real secrets.

# Local SQLite file. Production must use PostgreSQL, for example:
# postgresql+psycopg://election:REPLACE_WITH_A_LONG_PASSWORD@db:5432/election
DATABASE_URL=sqlite:///./data/elections.db

# Production requires explicit https origins. Local development can use http.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# development: open local workspace. private: one shared server token. accounts: per-user ownership.
AUTH_MODE=development

# Private mode only. At least 32 characters in production. Leave empty for development and accounts.
API_TOKEN=

# Accounts mode. Leave this false. Production startup rejects true.
ALLOW_REGISTRATION=false

# Used once, only when accounts mode has zero users. Remove the password after the first boot.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Operator command: python -m app.auth.cli
# The password is read from the environment, not from the command line.
CREATE_USER_EMAIL=
CREATE_USER_PASSWORD=

SESSION_HOURS=12

# Optional OpenAI-compatible chat completions endpoint. Empty keeps the deterministic parser.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Production refuses to start unless AUTH_MODE is accounts or private and the database checks pass.
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_ITERATIONS=50000

# Used by the Next.js server to reach the API. Inside Compose this is http://api:8000.
# Do not set NEXT_PUBLIC_API_INTERNAL_URL or NEXT_PUBLIC_API_TOKEN.
API_INTERNAL_URL=http://127.0.0.1:8000

# Local Compose database password. Production startup rejects this placeholder.
POSTGRES_PASSWORD=change-me-local-only

# Production Compose only. SITE_ADDRESS is the bare hostname, not a URL.
# CORS_ORIGINS must then be https://SITE_ADDRESS. Leave these empty for local development.
SITE_ADDRESS=
ACME_EMAIL=
# Production default is the web container address 172.28.10.10/32. Leave empty locally.
TRUSTED_PROXY_CIDRS=
# Set to true only after the first account exists and INITIAL_ADMIN_PASSWORD has been removed.
EXISTING_USERS=
